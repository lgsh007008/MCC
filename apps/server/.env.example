# server 环境变量清单（进 git）；真实 .env 不入库（技术方案 §9.3）
PORT=3001
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mcc?schema=public
REDIS_URL=redis://localhost:6379
# 访问令牌签名密钥（技术方案 §8.3：绝不许加公开前缀出现在前端变量中）
JWT_SECRET=
# 日志级别（trace/debug/info/warn/error，默认 info；dev 自动 pretty、CI/prod 输出 JSON——技术方案 §9.2）
LOG_LEVEL=info