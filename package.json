{
  "name": "mcc",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @mcc/db run generate",
    "db:migrate:dev": "pnpm --filter @mcc/db run migrate:dev",
    "db:migrate:deploy": "pnpm --filter @mcc/db run migrate:deploy",
    "db:studio": "pnpm --filter @mcc/db run studio"
  },
  "devDependencies": {
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.0.0"
  }
}
