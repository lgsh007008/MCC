# 生产环境变量模板（技术方案 §9.5）：
# 复制为服务器上的 /opt/mcc/.env.prod 后填入真实值，chmod 600；真实 .env.prod 不入库。
# ACR：阿里云容器镜像服务（个人版实例）控制台「访问凭证」页显示登录地址与用户名
ACR_REGISTRY=crpi-fxqkmlusk0ccjryy.cn-beijing.personal.cr.aliyuncs.com
ACR_NAMESPACE=meihaomcc
IMAGE_TAG=latest

# PostgreSQL（密码用 openssl rand -hex 24 生成，避免 @:/ 等字符破坏连接串）
POSTGRES_USER=mcc
POSTGRES_PASSWORD=replace-with-random-hex
POSTGRES_DB=mcc

# 访问令牌签名密钥（openssl rand -hex 48）
JWT_SECRET=replace-with-random-hex
LOG_LEVEL=info

# 只 IP 访问先开 80；若云厂商拦截 80，改为 8080
WEB_PORT=80
