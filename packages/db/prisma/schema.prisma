// 表结构的唯一事实源。通用字段约定与模式约定见技术方案 §5。
// 具体业务表随需求新增，每个领域只拥有自己的表（数据所有权，技术方案 §4.2）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 主键算法已锁定（技术方案 §5.1）：不可推测的全局唯一 ID，取 uuid v4。
// 新增模型一律以这五行为头（字段名、类型、映射均照此，禁止逐表另立写法）：
//   id        String    @id @default(uuid()) @db.Uuid
//   tenantId  String    @default("default") @map("tenant_id")
//   createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
//   updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
//   deletedAt DateTime? @map("deleted_at")
// tenant_id 全表预留（ADR-005，2026-11-09 复活）：当前单租户恒为 default；
// 租户条件由 server 数据访问层（common/prisma-tenant.extension.ts）统一附加，禁止业务层手写。

// ── 账号与权限领域（auth，design/账号与权限.md §2）────────────────
// user / refresh_token 均归本领域，细节以本文件为准。

enum UserRole {
  // 固定四角色（product/账号与权限.md R-账号与权限-003）；不预建角色表。
  ADMIN
  SALES
  FINANCE
  WORKER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  INACTIVE

  @@map("user_status")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 账号：按使用人一人一号，无自助注册（MVP 由初始化直接提供，见 design/账号与权限.md）。
  // 唯一性按租户隔离（ADR-005）：不同租户可重名/重令牌，故用复合唯一而非全局唯一。
  username     String   @map("username")
  passwordHash String   @map("password_hash")
  role         UserRole @default(SALES)
  status       UserStatus @default(ACTIVE) @map("status")

  refreshTokens RefreshToken[]

  @@unique([tenantId, username])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 服务端只存哈希（sha256），不存令牌原文（design/账号与权限.md §4）。
  tokenHash String  @map("token_hash")
  userId    String  @db.Uuid @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 过期时间对应「记住登录」口径：勾选 30 天，不勾选会话级。
  expiresAt DateTime @map("expires_at")
  // 撤销即置位（登出 / 改密后旧会话撤销），记录保留供审计。
  revokedAt DateTime? @map("revoked_at")

  @@unique([tenantId, tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

// ── 审计（server 全局基础设施，技术方案 §8.5 / §5.2 事件日志模式）────
// 操作审计日志：主体、时间、对象、动作、结果、终端；审计日志只增、不可篡改。
// 归属：audit 模块（modules/audit）；采集由 common 审计拦截器与 auth 显式调用写入。

model EventLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 操作主体（登录后写入 user id；匿名操作如登录失败为 null）
  actorId       String? @map("actor_id")
  actorUsername String? @map("actor_username")
  // 操作发生时的角色快照
  actorRole String? @map("actor_role")
  // 领域 + 动作（动作标识机器可读，动作名为中文展示）
  domain      String  @map("domain")
  action      String  @map("action")
  actionLabel String? @map("action_label")
  // 操作对象（如改密对象为账号 id；对象编号为业务编号快照）
  objectType String? @map("object_type")
  objectId   String? @map("object_id")
  objectCode String? @map("object_code")
  // 结果：ok / failed（旧记录可能为状态码或 error）
  result     String  @map("result")
  statusCode Int?    @map("status_code")
  errorCode  String? @map("error_code")
  // 请求与终端上下文（不含敏感信息）
  method    String? @map("method")
  path      String? @map("path")
  ip        String? @map("ip")
  userAgent String? @map("user_agent")
  requestId String? @map("request_id")
  payload   Json?   @map("payload")

  @@index([createdAt])
  @@index([actorId])
  @@index([tenantId, createdAt])
  @@index([actorId, createdAt])
  @@index([domain, action])
  @@map("event_logs")
}

// ── 客户领域（customer，design/customer.md §2）────────────────
// 客户档案：编号、名称、联系信息、状态、备注。
// 累计下单方量不落本表：由 order 域按未软删销售单聚合（product/customer.md R-客户-001）。

enum CustomerStatus {
  // 启用 / 停用；停用不可被新销售单选择，历史单据不受影响。
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @default("default") @map("tenant_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 编号 CT + 连字符 + 5 位全局流水（如 CT-00001），系统生成、只读、永不复用（1-产品文档.md 五）
  code    String         @map("code")
  name    String         @map("name")
  contact String         @default("") @map("contact")
  status  CustomerStatus @default(ACTIVE)
  note    String         @default("") @map("note")

  // 期初欠款：系统上线前已发生的净欠款（product/customer.md R-客户-001）。
  // 只作 finance 计算欠款的基数，不计入累计销售 / 累计收款 / 经营收支；历史回款不补录。
  openingDebt Decimal @default(0) @map("opening_debt") @db.Decimal(14, 2)

  saleOrders SaleOrder[]

  @@unique([tenantId, code])
  @@index([name])
  @@map("customers")
}

// ── 订单领域（order，design/order.md §2）────────────────
// sale_order / sale_order_item 均归本领域；客户 = 引用 + 快照（customer_id 归属与聚合，
// customer_name 为下单当时名称快照，客户改名不回改历史单据）。
// 收款与欠款不属本领域（finance 建成后另立需求，见 product/order.md 待补注记）。

enum SaleOrderItemType {
  // 产品类型当前仅「方木」：服务端固定写入，接口不接收（product/order.md R-订单-001）。
  // 板条等新类型随产品管理需求扩展。
  SQUARE_TIMBER

  @@map("sale_order_item_type")
}

enum SaleOrderPricingMode {
  // 计价方式：按方量（默认）/ 按根数；两种方式下都计算方量（工资依据）
  VOLUME
  PIECE

  @@map("sale_order_pricing_mode")
}

enum SaleOrderSettlementMode {
  // 结算方式：赊销（默认）/ 现结；现结时同事务生成收入事件 + 收款流水
  CREDIT
  SETTLED

  @@map("sale_order_settlement_mode")
}

model SaleOrder {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 主单编号：SO + 连字符 + 5 位全局流水（如 SO-00001），自动生成、只读、永不复用（1-产品文档.md 五）
  code     String   @map("code")
  saleDate DateTime @map("sale_date") @db.Date
  // 客户：外键用于归属与聚合；名称快照保留开单当时的名称（design/order.md §2）
  customerId   String   @map("customer_id") @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id])
  customerName String   @map("customer_name")
  // 合计/金额均为保存时按明细重算的落账快照，不手填（design/order.md §3）
  totalVolume    Decimal @map("total_volume") @db.Decimal(18, 4)
  subtotalAmount Decimal @map("subtotal_amount") @db.Decimal(18, 2)
  otherAmount    Decimal @default(0) @map("other_amount") @db.Decimal(18, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(18, 2)
  note           String  @default("") @map("note")

  // 结算：合计金额仍为原价；现结实收默认等于合计、可抹零 / 约整
  settlementMode SaleOrderSettlementMode @default(CREDIT) @map("settlement_mode")
  receivedAmount Decimal                 @default(0) @map("received_amount") @db.Decimal(18, 2)
  settleAccountId String?                @db.Uuid @map("settle_account_id")

  items SaleOrderItem[]

  @@unique([tenantId, code])
  @@index([saleDate])
  @@index([customerId])
  @@map("sale_orders")
}

model SaleOrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  orderId String    @map("order_id") @db.Uuid
  order   SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // 行序：明细编码 = 主单编号-行序；行序在行创建时分配、软删后作废、不回改不重排（design/order.md §4）
  seq Int @map("seq")

  productType SaleOrderItemType   @default(SQUARE_TIMBER) @map("product_type")
  pricingMode SaleOrderPricingMode @default(VOLUME) @map("pricing_mode")

  // 尺寸：整数毫米，顺序为长、宽、高；方量对所有行非空（每行都计算，工资依据）
  lengthMm    Int      @map("length_mm")
  widthMm     Int      @map("width_mm")
  heightMm    Int      @map("height_mm")
  pieces      Int      @map("pieces")
  volumeM3    Decimal  @map("volume_m3") @db.Decimal(18, 4)
  price       Decimal  @map("price") @db.Decimal(18, 2)

  // 行金额：按方量 = 方量×单价；按根数 = 根数×单价；其他金额为行级人工调整
  lineAmount  Decimal @map("line_amount") @db.Decimal(18, 2)
  otherAmount Decimal @default(0) @map("other_amount") @db.Decimal(18, 2)
  note        String  @default("") @map("note")

  @@unique([orderId, seq])
  @@index([orderId])
  @@map("sale_order_items")
}

// ── 财务领域（finance，design/finance.md §2）────────────────
// 资金流水单轨制：一笔钱一条流水，方向与收支分类表明性质。
// 管理会计口径，不做复式记账（product/finance.md 口径声明）。
// 销售单现结由订单域在同一事务内经 FinanceService 派生收款流水，源单唯一约束防重复。

enum FinanceCashCategory {
  // 收款（IN）
  SALES_RECEIPT
  OTHER_REVENUE
  LOAN_IN
  // 付款（OUT）
  PURCHASE_PAYMENT
  LABOR_COST
  OPERATING_EXPENSE
  ASSET_PURCHASE
  LOAN_REPAY

  @@map("finance_cash_category")
}

// ── 资金收付与固定资产（product/finance.md R-财务-002 / R-财务-003）──
// 收款不是收入，付款不是成本；收支分类决定是否计入经营收支。
// 账户余额 = 期初 + 收款 − 付款 + 转入 − 转出；内部转账不计入收支统计。

enum FinanceAccountKind {
  // 对公 / 对私（原「票据」类型取消，承兑汇票改为对公下的渠道）
  CORPORATE
  PERSONAL

  @@map("finance_account_kind")
}

enum FinanceAccountChannel {
  BANK
  WECHAT
  ALIPAY
  CASH
  BILL

  @@map("finance_account_channel")
}

enum FinanceCashDirection {
  IN
  OUT
  TRANSFER

  @@map("finance_cash_direction")
}

enum FinanceCashMethod {
  BANK
  WECHAT
  ALIPAY
  CASH
  ACCEPTANCE

  @@map("finance_cash_method")
}

model FinanceAccount {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @default("default") @map("tenant_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 账户编号：AC + 连字符 + 5 位全局流水（1-产品文档.md 五）
  code           String               @map("code")
  name           String               @map("name")
  kind           FinanceAccountKind   @default(CORPORATE) @map("kind")
  channel        FinanceAccountChannel @default(BANK) @map("channel")
  openingBalance Decimal              @default(0) @map("opening_balance") @db.Decimal(18, 2)
  active         Boolean              @default(true) @map("active")

  entries   FinanceCashEntry[] @relation("CashEntryAccount")
  transfers FinanceCashEntry[] @relation("CashEntryToAccount")

  @@unique([tenantId, code])
  @@index([name])
  @@map("finance_accounts")
}

model FinanceCashEntry {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @default("default") @map("tenant_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 流水编号：CF + 连字符 + 5 位全局流水（1-产品文档.md 五）
  code         String               @map("code")
  direction    FinanceCashDirection @map("direction")
  occurredDate DateTime             @map("occurred_date") @db.Date
  // 金额：正数，方向由 direction 决定
  amount       Decimal              @map("amount") @db.Decimal(18, 2)
  accountId    String               @map("account_id") @db.Uuid
  account      FinanceAccount       @relation("CashEntryAccount", fields: [accountId], references: [id])
  // 内部转账的转入账户
  toAccountId  String?              @map("to_account_id") @db.Uuid
  toAccount    FinanceAccount?      @relation("CashEntryToAccount", fields: [toAccountId], references: [id])
  // 收款挂客户（不挂销售单）；付款对象写入备注
  customerId   String?              @map("customer_id") @db.Uuid
  customerName String               @default("") @map("customer_name")
  // 方式由账户渠道推导，不单独录入
  method       FinanceCashMethod    @default(BANK) @map("method")
  // 收支分类：收款 / 付款必填，内部转账为 NULL；决定是否计入经营收支
  category     FinanceCashCategory? @map("category")
  note         String               @default("") @map("note")
  // 源单：当前仅销售单现结派生；手工流水三列为 NULL
  sourceType   String?              @map("source_type")
  sourceId     String?              @db.Uuid @map("source_id")
  sourceCode   String?              @map("source_code")

  @@unique([tenantId, code])
  // 同一源单最多派生一条流水（手工流水三列 NULL，唯一索引允许多个 NULL）
  @@unique([tenantId, sourceType, sourceId])
  @@index([occurredDate])
  @@index([accountId])
  @@index([customerId])
  @@index([category])
  @@map("finance_cash_entries")
}
