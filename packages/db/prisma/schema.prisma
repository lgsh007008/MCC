// 表结构的唯一事实源。通用字段约定与模式约定见技术方案 §5。
// 具体业务表随需求新增，每个领域只拥有自己的表（数据所有权，技术方案 §4.2）。

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 主键算法已锁定（技术方案 §5.1）：不可推测的全局唯一 ID，取 uuid v4。
// 新增模型一律以这五行为头（字段名、类型、映射均照此，禁止逐表另立写法）：
//   id        String    @id @default(uuid()) @db.Uuid
//   tenantId  String    @default("default") @map("tenant_id")
//   createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
//   updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
//   deletedAt DateTime? @map("deleted_at")
// tenant_id 全表预留（ADR-005，2026-11-09 复活）：当前单租户恒为 default；
// 租户条件由 server 数据访问层（common/prisma-tenant.extension.ts）统一附加，禁止业务层手写。

// ── 账号与权限领域（auth，design/账号与权限.md §2）────────────────
// user / refresh_token 均归本领域，细节以本文件为准。

enum UserRole {
  // 单角色「销售」全权限（product/账号与权限.md R-账号与权限-001）；
  // 新增角色随需求扩展，不预建角色表。
  SALES

  @@map("user_role")
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 账号：按使用人一人一号，无自助注册（MVP 由初始化直接提供，见 design/账号与权限.md）。
  // 唯一性按租户隔离（ADR-005）：不同租户可重名/重令牌，故用复合唯一而非全局唯一。
  username     String   @map("username")
  passwordHash String   @map("password_hash")
  role         UserRole @default(SALES)

  refreshTokens RefreshToken[]

  @@unique([tenantId, username])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 服务端只存哈希（sha256），不存令牌原文（design/账号与权限.md §4）。
  tokenHash String  @map("token_hash")
  userId    String  @db.Uuid @map("user_id")
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  // 过期时间对应「记住登录」口径：勾选 30 天，不勾选会话级。
  expiresAt DateTime @map("expires_at")
  // 撤销即置位（登出 / 改密后旧会话撤销），记录保留供审计。
  revokedAt DateTime? @map("revoked_at")

  @@unique([tenantId, tokenHash])
  @@index([userId])
  @@map("refresh_tokens")
}

// ── 审计（server 全局基础设施，技术方案 §8.5 / §5.2 事件日志模式）────
// 全量写操作的审计日志：主体、时间、对象、动作、结果；审计日志只增、不可篡改。
// 归属：横切中间件（common/audit），不属任何业务模块（技术方案 §1.1）。

model EventLog {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 操作主体（登录后写入 user id；匿名操作如登录失败为 null）
  actorId       String? @map("actor_id")
  actorUsername String? @map("actor_username")
  // 领域 + 动作：由请求路径解析（如 /api/v1/auth/login → auth / login）
  domain  String  @map("domain")
  action  String  @map("action")
  // 操作对象（如改密对象为账号 id）
  objectType String? @map("object_type")
  objectId   String? @map("object_id")
  // 结果：ok / error / forbidden 等
  result String @map("result")
  // 附加上下文（不含敏感信息）
  payload Json? @map("payload")

  @@index([createdAt])
  @@index([actorId])
  @@map("event_logs")
}

// ── 客户领域（customer，design/customer.md §2）────────────────
// 客户档案：编号、名称、联系信息、状态、备注。
// 累计下单方量不落本表：由 order 域按未软删销售单聚合（product/customer.md R-客户-001）。

enum CustomerStatus {
  // 启用 / 停用；停用不可被新销售单选择，历史单据不受影响。
  ACTIVE
  INACTIVE

  @@map("customer_status")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  tenantId  String    @default("default") @map("tenant_id")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 编号 C + 5 位全局流水（如 C00001），系统生成、只读、永不复用（design/customer.md §3）
  code    String         @map("code")
  name    String         @map("name")
  contact String         @default("") @map("contact")
  status  CustomerStatus @default(ACTIVE)
  note    String         @default("") @map("note")

  saleOrders SaleOrder[]

  @@unique([tenantId, code])
  @@index([name])
  @@map("customers")
}

// ── 订单领域（order，design/order.md §2）────────────────
// sale_order / sale_order_item 均归本领域；客户 = 引用 + 快照（customer_id 归属与聚合，
// customer_name 为下单当时名称快照，客户改名不回改历史单据）。
// 收款与欠款不属本领域（finance 建成后另立需求，见 product/order.md 待补注记）。

enum SaleOrderItemType {
  // 产品类型两值（product/order.md R-订单-001）：板材按方量计费，其他非方量手填金额。
  BOARD
  OTHER

  @@map("sale_order_item_type")
}

model SaleOrder {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  // 主单编号：年月+当月流水（如 202611-0001），自动生成、只读、永不复用（design/order.md §4）
  code     String   @map("code")
  saleDate DateTime @map("sale_date") @db.Date
  // 客户：外键用于归属与聚合；名称快照保留开单当时的名称（design/order.md §2）
  customerId   String   @map("customer_id") @db.Uuid
  customer     Customer @relation(fields: [customerId], references: [id])
  customerName String   @map("customer_name")
  // 合计/金额均为保存时按明细重算的落账快照，不手填（design/order.md §3）
  totalVolume    Decimal @map("total_volume") @db.Decimal(18, 4)
  subtotalAmount Decimal @map("subtotal_amount") @db.Decimal(18, 2)
  otherAmount    Decimal @default(0) @map("other_amount") @db.Decimal(18, 2)
  totalAmount    Decimal @map("total_amount") @db.Decimal(18, 2)
  note           String  @default("") @map("note")

  items SaleOrderItem[]

  @@unique([tenantId, code])
  @@index([saleDate])
  @@index([customerId])
  @@map("sale_orders")
}

model SaleOrderItem {
  id        String   @id @default(uuid()) @db.Uuid
  tenantId  String   @default("default") @map("tenant_id")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt DateTime? @map("deleted_at")

  orderId String    @map("order_id") @db.Uuid
  order   SaleOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // 行序：明细编码 = 主单编号-行序；行序在行创建时分配、软删后作废、不回改不重排（design/order.md §4）
  seq Int @map("seq")

  productType SaleOrderItemType @map("product_type")

  // 板材行：长宽厚（cm，3 位小数）、根数、方量、单价；「其他」行以上字段为 null
  thicknessCm Decimal? @map("thickness_cm") @db.Decimal(10, 3)
  widthCm     Decimal? @map("width_cm") @db.Decimal(10, 3)
  lengthCm    Decimal? @map("length_cm") @db.Decimal(10, 3)
  pieces      Int?     @map("pieces")
  volumeM3    Decimal? @map("volume_m3") @db.Decimal(18, 4)
  price       Decimal? @map("price") @db.Decimal(18, 2)

  // 行金额：板材自动 = 方量×单价；其他手填；其他金额两类型通用兜底（product/order.md R-订单-001）
  lineAmount  Decimal @map("line_amount") @db.Decimal(18, 2)
  otherAmount Decimal @default(0) @map("other_amount") @db.Decimal(18, 2)
  note        String  @default("") @map("note")

  @@unique([orderId, seq])
  @@index([orderId])
  @@map("sale_order_items")
}