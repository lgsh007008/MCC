  "info": {
    "title": "MCC 业务 API",
    "description": "梅好木业数字化系统统一业务 API（ADR-002：人与 Agent 平级消费同一套接口）",
    "version": "v1",
    "contact": {}
  },
  "tags": [
    {
      "name": "auth",
      "description": "账号与权限"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "description": "登录/刷新接口返回的 accessToken"
      }
    },
    "schemas": {
      "LoginBodyDto": {
        "type": "object",
        "properties": {
          "username": {
            "type": "string",
            "description": "账号，一人一号",
            "example": "admin"
          },
          "password": {
            "type": "string",
            "description": "密码",
            "example": "Mcc@2026"
          },
          "rememberMe": {
            "type": "boolean",
            "description": "记住登录：勾选 → 刷新令牌 30 天；不勾选 → 会话级",
            "default": false
          }
        },
        "required": [
          "username",
          "password",
          "rememberMe"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "短期访问令牌，web 端存内存并以 Bearer 请求头携带"
          },
          "username": {
            "type": "string",
            "description": "账号名"
          },
          "role": {
            "type": "string",
            "description": "角色（当前恒为 SALES）"
          }
        },
        "required": [
          "accessToken",
          "username",
          "role"
        ]
      },
      "RefreshRequestDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "无 Cookie 端（如 miniapp）经请求体传递刷新令牌；web 走 Cookie 时无需此字段"
          }
        }
      },
      "RefreshResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "新签发的访问令牌"
          }
        },
        "required": [
          "accessToken"
        ]
      },
      "ChangePasswordBodyDto": {
        "type": "object",
        "properties": {
          "oldPassword": {
            "type": "string",
            "description": "旧密码"
          },
          "newPassword": {
            "type": "string",
            "description": "新密码，至少 8 位"
          }
        },
        "required": [
          "oldPassword",
          "newPassword"
        ]
      },
      "CustomerDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "客户 id"
          },
          "code": {
            "type": "string",
            "description": "客户编号（C + 5 位流水）"
          },
          "name": {
            "type": "string",
            "description": "客户名称"
          },
          "contact": {
            "type": "string",
            "description": "联系信息"
          },
          "status": {
            "type": "string",
            "description": "状态：active 启用 / inactive 停用"
          },
          "note": {
            "type": "string",
            "description": "备注"
          },
          "createdAt": {
            "type": "string",
            "description": "创建日期（YYYY-MM-DD）"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "contact",
          "status",
          "note",
          "createdAt"
        ]
      },
      "CustomerListDto": {
        "type": "object",
        "properties": {
          "total": {
            "type": "number",
            "description": "总数"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CustomerDto"
            }
          }
        },
        "required": [
          "total",
          "items"
        ]
      },
      "CustomerNameCheckDto": {
        "type": "object",
        "properties": {
          "duplicate": {
            "type": "boolean",
            "description": "是否存在同名客户（未软删）"
          }
        },
        "required": [
          "duplicate"
        ]
      },
      "CustomerBodyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "客户名称",
            "example": "张三木材店"
          },
          "contact": {
            "type": "string",
            "description": "联系信息（电话等）",
            "default": ""
          },
          "note": {
            "type": "string",
            "description": "备注",
            "default": ""
          }
        },
        "required": [
          "name"
        ]
      },
      "CustomerStatusBodyDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "description": "状态：active 启用 / inactive 停用"
          }
        },
        "required": [
          "status"
        ]
      },
      "CustomerBatchStatusBodyDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "客户 id 列表（1~200）",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "inactive"
            ],
            "description": "目标状态：active 启用 / inactive 停用"
          }
        },
        "required": [
          "ids",
          "status"
        ]
      },
      "CustomerBatchStatusResponseDto": {
        "type": "object",
        "properties": {
          "updated": {
            "type": "number",
            "description": "实际变更条数（已软删或已处于目标状态的跳过）"
          }
        },
        "required": [
          "updated"
        ]
      },
      "CustomerBatchDeleteBodyDto": {
        "type": "object",
        "properties": {
          "ids": {
            "description": "要删除的客户 id 列表（1~200）",
